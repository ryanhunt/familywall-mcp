# Dummy local values only. Never put real credentials or keys in this file.
FAMILYWALL_MODE=stdio
FAMILYWALL_LOCAL_SUBJECT=local-development-user
FAMILYWALL_BASE_URL=https://familywall.example.invalid
FAMILYWALL_DATABASE_PATH=data/familywall.sqlite3

# FamilyWall credentials (required for MCP tools)
# FAMILYWALL_EMAIL=email@example.com
# FAMILYWALL_PASSWORD=yourpassword

# Write gate: set to "true" to enable write tools (add_list_item, set_list_item_checked)
FAMILYWALL_ENABLE_WRITES=false

# Required for hosted mode; replace only in a local secret store.
# FAMILYWALL_MODE=hosted
# FAMILYWALL_PUBLIC_URL=https://mcp.example.invalid
# FAMILYWALL_AUTH_SECRET_KEY=replace-with-a-random-key-at-least-32-characters
