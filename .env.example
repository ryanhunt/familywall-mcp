# Dummy local values only. Never put real credentials or keys in this file.
FAMILYWALL_MODE=stdio
FAMILYWALL_LOCAL_SUBJECT=local-development-user
FAMILYWALL_BASE_URL=https://familywall.example.invalid
FAMILYWALL_DATABASE_PATH=data/familywall.sqlite3

# FamilyWall credentials (required for MCP tools)
# FAMILYWALL_EMAIL=email@example.com
# FAMILYWALL_PASSWORD=yourpassword

# Write gate: set to "true" to enable write tools (add_list_item, set_list_item_checked)
FAMILYWALL_ENABLE_WRITES=false

# Hosted mode: multi-user OAuth backed by .env static configuration.
# See docs/decisions/0002-simplified-hosted-auth.md for the design rationale.
# Required variables for hosted mode:
# - FAMILYWALL_MODE: set to "hosted"
# - FAMILYWALL_PUBLIC_URL: the HTTPS URL of this server (e.g., https://mcp.example.com)
# - FAMILYWALL_AUTH_SECRET_KEY: a random string of at least 32 characters for signing cookies/CSRF tokens
# - At least one FAMILYWALL_USER_<N>_* block (see below)
# - FAMILYWALL_ALLOWED_REDIRECT_URI_HOSTS: comma-separated hosts that clients may redirect to after OAuth login
#
# To configure hosted mode:
# 1. Replace values below and uncomment
# 2. Copy Caddyfile.example to Caddyfile and update the domain
# 3. Run: docker compose -f docker-compose.prod.yml up -d --build
#
# Hosted mode variables:
# FAMILYWALL_MODE=hosted
# FAMILYWALL_PORT=8000
# FAMILYWALL_PUBLIC_URL=https://mcp.example.com
# FAMILYWALL_AUTH_SECRET_KEY=replace-with-a-random-key-at-least-32-characters
# FAMILYWALL_ALLOWED_REDIRECT_URI_HOSTS=claude.ai,chatgpt.com
#
# User 1 (required for hosted mode; one per person):
# FAMILYWALL_USER_1_MCP_USERNAME=user1
# FAMILYWALL_USER_1_MCP_PASSWORD=user1password
# FAMILYWALL_USER_1_FW_EMAIL=user1@example.com
# FAMILYWALL_USER_1_FW_PASSWORD=familywallpassword1
#
# User 2 (optional; uncomment to add a second user):
# FAMILYWALL_USER_2_MCP_USERNAME=user2
# FAMILYWALL_USER_2_MCP_PASSWORD=user2password
# FAMILYWALL_USER_2_FW_EMAIL=user2@example.com
# FAMILYWALL_USER_2_FW_PASSWORD=familywallpassword2
#
# Notes:
# - MCP usernames and passwords are arbitrary and may differ from FamilyWall credentials
# - MCP usernames must be 1-100 characters of letters, digits, '.', '_' or '-'
# - Each FamilyWall email/password pair must be the real account credentials for that person
# - Up to 20 users can be configured (FAMILYWALL_USER_1_* through FAMILYWALL_USER_20_*)
# - Only contiguous numbered blocks are scanned; the scan stops at the first gap
# - FAMILYWALL_ALLOWED_REDIRECT_URI_HOSTS tells the OAuth provider which client apps
#   may request authorization; recommended values for the first deployment:
#   - claude.ai (for Claude custom connectors)
#   - chatgpt.com (for ChatGPT developer mode)
#   Leave unset while initially testing localhost, but ensure it is set before
#   adding to production Claude/ChatGPT deployments.
